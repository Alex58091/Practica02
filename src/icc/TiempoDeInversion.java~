/**
 *Programa de simulación de inversiones
 *Solicita datos, el monto a invertir, fechas de inicio y fin
 *Calcula los días de inversion y el rendimiento
 *utilizando una tasa anual del 12%
 *
 *@author Alexander Perez Laguna
 *@version 1.0
 */
package icc;
import java.util.Scanner;

public class TiempoDeInversion {
    /**
     *ejecuta el programa de simulacion de inversiones.
     *Solicita los datos, calcula el tiempo de inversion y muestra el rendimiento obtenido
     *permite realizar varias simulaciones
     *@param args argumentos recibidos 
     *
     */

    public static void main(String[] args) {

        Scanner in = new Scanner(System.in);

        String respuesta;

        do {


            System.out.println("Bienvenido al simulador de inversion, ¿Cuál es tu nombre?");
            String nombre = in.nextLine();
            System.out.println("Hola " + nombre + "¿Cuanto deseas invertir?");
            double monto = in.nextDouble();
            System.out.println("Fecha de inicio de inversion");
            System.out.println("Dia:");
            int diaInicio = in.nextInt();
            System.out.println("Mes:");
            int mesInicio = in.nextInt();
            System.out.println("Anio:");
            int anioInicio = in.nextInt();
            Fecha inicio = new Fecha(diaInicio, mesInicio, anioInicio);
            System.out.println("Fecha de fin de inversion");
            System.out.println("Dia:");
            int diaFin = in.nextInt();
            System.out.println("Mes:");
            int mesFin = in.nextInt();
            System.out.println("Anio:");
            int anioFin = in.nextInt();
            Fecha fin = new Fecha(diaFin, mesFin, anioFin);
            int dias = inicio.diferencia(fin);
            double rendimiento = monto * 0.12 * dias / 365;
            System.out.println("Resumen de inversion");
            System.out.println("Inversionista: " + nombre);
            System.out.println("Monto invertido: $" + monto);
            System.out.println("Fecha inicial: " + inicio);
            System.out.println("Fecha final: " + fin);
            System.out.println("Dias de inversion: " + dias);
            System.out.println("Rendimiento al 12%: $" + rendimiento);
            System.out.println("Total al finalizar: $" + (monto + rendimiento));
            System.out.println("Deseas realizar otra simulacion? (si/no)");
            in.nextLine();
            respuesta = in.nextLine();
        } while (respuesta.equals("si") || respuesta.equals("sí"));
        System.out.println("Gracias por utilizar el simulador.");
        in.close();
    }
}
